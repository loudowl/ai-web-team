# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Reasoning-capable default; served via the OpenAI Responses API.
OPENAI_MODEL=gpt-5.6

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default provider: openai | anthropic | ollama
DEFAULT_PROVIDER=openai

# Reasoning models can spend hidden tokens before visible output.
MAX_TOKENS_AGENT=8192

# ── GitHub (for pushing generated projects) ───────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# ── Jira Mode (optional — manual paste works without these) ───────────────────
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
# REPO_CONTEXT_PATH=/path/to/single/repo
# WORKTREE_BASE=data/worktrees
# SENIOR_DEV_MODEL=codestral
# GITHUB_BASE_BRANCH=main
# JIRA_BRANCH_PREFIX=codex
# JIRA_BRANCH_SUFFIX=

# ── Local Ollama performance (recommended on 16–24GB RAM) ─────────────────────
# Large models (e.g. codestral) + high context can saturate RAM and swap.
# Smaller context — still enough for most Jira tickets
# OLLAMA_NUM_CTX=8192
# Unload model when idle (use 0 to unload after every request)
# OLLAMA_KEEP_ALIVE=5m
# Limit CPU threads so macOS stays responsive
# OLLAMA_NUM_THREAD=4
# One ticket at a time (raise for cloud providers)
# JIRA_MAX_PARALLEL=1
# Point REPO_CONTEXT_PATH at ONE repo, not a parent folder with many repos
# Optional: shorter generations = less sustained load
# MAX_TOKENS_AGENT=4096
# Optional: lighter local model instead of codestral
# SENIOR_DEV_MODEL=llama3.2
# Optional Ollama daemon limits (set in shell profile or launchd, not here):
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1

# ── Dev server (python main.py) ───────────────────────────────────────────────
# Disable uvicorn auto-reload during Jira runs — worktree file writes interrupt agents.
# RELOAD=false
# PORT=3001

# ── Optional per-agent model overrides ────────────────────────────────────────
# PM_MODEL=
# DESIGNER_MODEL=
# ARCHITECT_MODEL=
# DEVELOPER_MODEL=

# ── Optional per-agent reasoning effort (OpenAI reasoning models) ─────────────
# Harder tasks get more thinking budget. One of: low | medium | high
# PM_EFFORT=low
# DESIGNER_EFFORT=medium
# ARCHITECT_EFFORT=high
# DEVELOPER_EFFORT=high
