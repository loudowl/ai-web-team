# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Reasoning-capable default; served via the OpenAI Responses API.
OPENAI_MODEL=gpt-5.6

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default provider: openai | anthropic | ollama
DEFAULT_PROVIDER=openai

# Reasoning models can spend hidden tokens before visible output.
MAX_TOKENS_AGENT=8192

# ── GitHub (for pushing generated projects) ───────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# ── Jira Mode (optional — manual paste works without these) ───────────────────
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
# REPO_CONTEXT_PATH=/path/to/repos
# WORKTREE_BASE=data/worktrees
# SENIOR_DEV_MODEL=codestral

# ── Optional per-agent model overrides ────────────────────────────────────────
# PM_MODEL=
# DESIGNER_MODEL=
# ARCHITECT_MODEL=
# DEVELOPER_MODEL=

# ── Optional per-agent reasoning effort (OpenAI reasoning models) ─────────────
# Harder tasks get more thinking budget. One of: low | medium | high
# PM_EFFORT=low
# DESIGNER_EFFORT=medium
# ARCHITECT_EFFORT=high
# DEVELOPER_EFFORT=high
